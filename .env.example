# Copy to .env. Every value is optional; the tool runs with none of them set.

# Scene suggestions come from Claude when this is set, otherwise from a
# built-in heuristic (the UI says which one ran).
ANTHROPIC_API_KEY=
SCENES_MODEL=claude-opus-5

# ffmpeg / ffprobe. Default order: these paths, then the ffmpeg-static npm
# binaries, then whatever is on PATH. The ffmpeg build MUST include libass
# (run `npm run doctor` to check).
#   Mac (Homebrew):  FFMPEG_PATH=/opt/homebrew/opt/ffmpeg-full/bin/ffmpeg
#   Windows (gyan.dev full build): FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
FFMPEG_PATH=
FFPROBE_PATH=

# Voice. Mac: any name from `say -v '?'` (default Samantha).
# Windows: any installed System.Speech voice (default: first one found,
# usually "Microsoft Zira Desktop" or "Microsoft David Desktop").
TTS_VOICE=
# Mac: words per minute (default 175). Windows: -10..10 (default 0).
TTS_RATE=

# Optional and untested in this build: set a key to use ElevenLabs with
# real word timestamps. Falls back to the OS voice on any error.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Server port (default 3000).
PORT=
